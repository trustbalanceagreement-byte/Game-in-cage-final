rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net - deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Authenticated and offline profile data storage path
    match /users/{userId} {
      allow read, write: if true;

      // User-specific notifications path
      match /notifications/{notificationId} {
        allow read, write: if true;
      }
    }

    // Dynamic events broadcast collection
    match /events/{eventId} {
      allow read, write: if true;
    }

    // Esports active tournaments path
    match /tournaments/{tournamentId} {
      allow read, write: if true;
    }

    // User tournament booking registration path
    match /tournament_bookings/{bookingId} {
      allow read, write: if true;
    }

    // Immersive custom hero settings path
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Bill number submission & Cage coins verification path
    match /bill_submissions/{billId} {
      allow read, write: if true;
    }
  }
}
